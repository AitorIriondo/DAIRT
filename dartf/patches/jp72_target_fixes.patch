+# Baseline precision per route. text_c16 is built FP32: it runs once per prompt set
+# (~41 ms vs ~14 ms FP16 on AGX Orin) and FP16 drifts on padded token positions
+# beyond the frozen per-element golden tolerance. vision/ground stay FP16.
+plan_precision() {
+  case "$1" in
+    text_c16) echo fp32 ;;
+    *) echo fp16 ;;
+  esac
+}
+
+# Vision route. TensorRT 10.16 on SM87 miscompiles the trunk's qkv-split/RoPE fusion in every precision and the
+# FP16 attention@V MatMul is numerically wrong, so the vision plan always needs --break-fusion and either
+#   int8 (default): explicit Q/DQ INT8 graph assets/vision_1008_int8.onnx (W8 blocks 1-31, A8 proj everywhere +
+#                   all GEMMs from block 8; ~220 ms; detection-level agreement with FP32 within noise), or
+#   fp16: assets/vision_1008.onnx with attention@V/Softmax/LayerNorm pinned to FP32 (correct, ~466 ms).
+#   hf16: assets/vision_1008_hf.onnx — the DART/HuggingFace export of the same weights (explicit Q·Kᵀ, real-valued
+#         RoPE). Correct in plain FP16 on TensorRT 10.16 with no breaker/pinning (~275 ms).
+#   hfint8 (recommended): assets/vision_1008_hf_int8.onnx — same recipe as int8 on the HF graph (~229 ms).
+# Select with LQ_VISION_MODE=int8|fp16|hf16|hfint8 (default hfint8).
+VISION_MODE="${LQ_VISION_MODE:-hfint8}"
+vision_onnx() {
+  case "${VISION_MODE}" in
+    int8) echo "${ONNX_DIR}/vision_1008_int8.onnx" ;;
+    fp16) echo "${ONNX_DIR}/vision_1008.onnx" ;;
+    hf16) echo "${ONNX_DIR}/vision_1008_hf.onnx" ;;
+    hfint8) echo "${ONNX_DIR}/vision_1008_hf_int8.onnx" ;;
+    *) echo "unknown LQ_VISION_MODE: ${VISION_MODE}" >&2; return 1 ;;
