# --- Model weights, engines, exports -----------------------------------------
# TensorRT engines are specific to one GPU *and* one TensorRT version, so they
# are never portable and must be rebuilt on each machine. ONNX exports are large
# and reproducible. None of this belongs in git.
*.engine
*.onnx
*.onnx.data
*.pt
*.pth
*.safetensors
onnx_hf_backbone/
distilled/
stage1_all_converted/

# --- Media -------------------------------------------------------------------
# Input footage and rendered outputs. Keep source videos wherever you like, but
# not in the repository.
*.mp4
*.MOV
*.mov
*.avi
*.mkv
*.m4v

# --- Generated results -------------------------------------------------------
outputs/
contact_*.html
contact_*.json
*_report.html
*_standalone.html

# --- Scratch -----------------------------------------------------------------
# Frames and crops written while checking prompts and masks.
*.jpg
*.jpeg
*.png
!docs/img/*.png
!docs/img/*.jpg

# --- Datasets ----------------------------------------------------------------
train2017/
val2017/
coco*/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

